    #[cfg(context = "st-nucleo-wb55")]
    {
        use embassy_stm32::rcc::*;

        rcc.hsi48 = Some(Hsi48Config {
            sync_from_usb: true,
        }); // needed for USB
        rcc.sys = Sysclk::PLL1_R;
        rcc.hse = Some(Hse {
            freq: embassy_stm32::time::Hertz(32000000),
